@page "/dynamic-data"
@inject HttpClient Http

<h3>Dynamic Data Viewer</h3>

<div class="mb-3">
    <input @bind="targetCollection" class="form-control d-inline-block w-auto" placeholder="Collection Name" />
    <button class="btn btn-primary" @onclick="LoadData">Fetch Data</button>
</div>

@if (dynamicData != null && dynamicData.Any())
{
    // Extract headers from the first document's keys
    var headers = dynamicData.First().Keys.ToList();

    <table class="table table-striped">
        <thead>
        <tr>
            @foreach (var header in headers)
            {
                <th>@header</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var row in dynamicData)
        {
            <tr>
                @foreach (var header in headers)
                {
                    <td>@(row.ContainsKey(header) ? row[header]?.ToString() : "")</td>
                }
            </tr>
        }
        </tbody>
    </table>
}
else if (isSearching)
{
    <p>Loading or no data found...</p>
}

@code {
    private string targetCollection = "";
    private List<Dictionary<string, object>>? dynamicData;
    private bool isSearching = false;

    private async Task LoadData()
    {
        if (string.IsNullOrWhiteSpace(targetCollection)) return;

        isSearching = true;
        try 
        {
            dynamicData = await Http.GetFromJsonAsync<List<Dictionary<string, object>>>(
                $"api/data/{targetCollection}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            dynamicData = null;
        }
        finally 
        {
            isSearching = false;
        }
    }
}